---
interface Props {
  title: string;
  tagline: string;
}

const { title, tagline } = Astro.props;
---

<section class="w-full pt-36 pb-20 md:pt-52 md:pb-40" id="hero">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="flex flex-col max-w-4xl gap-4 md:gap-8">
      <h1
        class="reveal-text text-xl leading-[1.1] uppercase tracking-wider"
        aria-label={title}
        data-hero="true"
        data-speed="fast"
      >
        {title}
      </h1>
      <h2
        class="reveal-text text-5xl xs:text-6xl sm:text-7xl md:text-8xl font-medium tracking-tighter leading-[1.1] text-neutral-950"
        aria-label={tagline}
        data-hero="true"
        data-delay="0.25"
      >
        {tagline}
      </h2>
    </div>
  </div>
</section>
