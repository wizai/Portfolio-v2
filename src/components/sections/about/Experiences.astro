---
interface Experience {
  sector?: string;
  company: string;
  role: string;
  period: string;
}

const experiences: Experience[] = [
  {
    sector: "FinTech",
    company: "MONI",
    role: "Creative Front-End Developer",
    period: "2021 — 2025",
  },
  {
    sector: "Digital Agency",
    company: "NGA",
    role: "Front-End Developer",
    period: "2016 — 2021",
  },
  {
    company: "HETIC / ECV Digital",
    role: "Web Developer & Student",
    period: "2016 — 2019",
  },
];
---

<section
  id="experiences"
  class="w-full bg-white text-neutral-950 pb-20 md:pb-40"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="mb-12 md:mb-24">
      <h2
        class="reveal-text text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-none text-neutral-950"
        aria-label="Selected Experiences"
      >
        Selected Experiences
      </h2>
    </div>
    <div class="flex flex-col">
      {
        experiences.map((experience, index) => {
          const rowDelay = index * 0.1 + 0.1;
          const rowId = `row-${experience.company.toLowerCase().replace(/[^a-z0-9]/g, "-")}`;

          return (
            <div
              class="reveal-block border-t border-neutral-100 last:border-b py-4 md:py-8 will-change-transform"
              data-delay={rowDelay}
              id={rowId}
              data-delay={rowDelay}
            >
              <div class="flex flex-col md:flex-row gap-4 md:gap-10 md:items-center w-full">
                <p
                  class="reveal-text text-4xl md:text-5xl font-medium text-neutral-950"
                  data-trigger={`#${rowId}`}
                  data-delay="0.1"
                >
                  {experience.company}
                </p>

                <div class="flex flex-col shrink-0">
                  {experience.sector && (
                    <p
                      class="reveal-text text-xs italic font-light text-neutral-400 mb-0.5"
                      data-trigger={`#${rowId}`}
                      data-delay="0.2"
                      data-speed="fast"
                    >
                      {experience.sector}
                    </p>
                  )}
                  <p
                    class="reveal-text text-xl text-neutral-800"
                    data-trigger={`#${rowId}`}
                    data-delay="0.25"
                    data-speed="fast"
                  >
                    {experience.role}
                  </p>
                </div>
                <p
                  class="reveal-text font-light md:ml-auto shrink-0"
                  data-trigger={`#${rowId}`}
                  data-delay="0.3"
                  data-speed="fast"
                >
                  {experience.period}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
