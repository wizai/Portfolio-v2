---
import { Image } from "astro:assets";
import imageProfil from "../../../assets/profil.jpg";
import RoundedButton from "../../ui/RoundedButton.astro";
---

<section class="w-full bg-white text-neutral-950 pb-20 md:pb-52" id="about">
  <div
    class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center"
  >
    <div class="col-span-1 md:col-span-6 w-full">
      <div
        class="reveal-block w-full will-change-transform"
        data-delay="0"
        data-trigger="#about"
      >
        <div
          class="media-wrapper overflow-hidden rounded-3xl bg-neutral-50 aspect-[4/3]"
        >
          <div class="media-target w-full scale-[1.02] will-change-transform">
            <Image
              src={imageProfil}
              widths={[240, 540, imageProfil.width]}
              sizes={`(max-width: 360px) 240px, (max-width: 768px) 540px, ${imageProfil.width}px`}
              alt="William Nisole - Front-End Developer"
              class="w-full h-full object-cover rounded-2xl shadow-sm"
            />
          </div>
        </div>
      </div>
    </div>

    <div
      class="col-span-1 md:col-span-6 flex flex-col items-start space-y-6 md:space-y-8"
    >
      <h2
        class="reveal-text text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-neutral-950 leading-[1.1]"
        data-delay="0.15"
        data-trigger="#about"
      >
        From digital agency to FinTech product.
      </h2>

      <p
        class="reveal-text text-neutral-500 text-base leading-relaxed tracking-wide"
        data-delay="0.35"
        data-trigger="#about"
      >
        After working on multiple web projects in a digital agency, I spent the
        last few years in a FinTech product team, focusing on UI development and
        component quality.
      </p>

      <div
        class="reveal-block w-full sm:w-auto"
        data-delay="0.55"
        data-trigger="#about"
      >
        <RoundedButton href="/about" text="About me" />
      </div>
    </div>
  </div>
</section>
