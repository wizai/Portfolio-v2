---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

const orderedSlugs = ["moni", "watchr", "rainr", "mazda"];
const projects = allProjects.sort(
  (a, b) => orderedSlugs.indexOf(a.id) - orderedSlugs.indexOf(b.id),
);

const leftColumnProjects = projects.filter((_, index) => index % 2 === 0);
const rightColumnProjects = projects.filter((_, index) => index % 2 !== 0);
---

<section id="projects" class="w-full bg-white text-neutral-950 pb-20 md:pb-52">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="mb-12 md:mb-24">
      <h2
        class="reveal-text text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight leading-none text-neutral-950"
        aria-label="Selected work"
      >
        Selected work
      </h2>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-x-28 md:gap-y-0 items-start"
    >
      <div class="flex flex-col gap-12 md:gap-y-28">
        {
          leftColumnProjects.map((project) => {
            const aspectClass =
              project.data.coverAspectClass || "aspect-[500/675]";
            return (
              <div class="w-full">
                <a
                  href={`/projects/${project.id}`}
                  class="group block text-left"
                >
                  <div class="reveal-block w-full">
                    <div
                      class:list={[
                        "media-wrapper overflow-hidden rounded-3xl bg-neutral-50 mb-6 md:mb-8 transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-98 will-change-transform",
                        aspectClass,
                      ]}
                    >
                      <div class="media-target w-full scale-[1.03] will-change-transform">
                        <Image
                          src={project.data.coverImg}
                          widths={[380, 640, project.data.coverImg.width]}
                          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 600px"
                          alt={`${project.data.title} Cover Showcase`}
                          class="w-full h-full object-cover select-none pointer-events-none"
                        />
                      </div>
                    </div>
                  </div>
                  <div class="text-lg md:text-xl font-normal tracking-tight leading-snug text-neutral-950 max-w-md">
                    {project.data.tagline}
                  </div>
                </a>
              </div>
            );
          })
        }
      </div>

      <div class="flex flex-col gap-12 md:gap-y-28 md:mt-38">
        {
          rightColumnProjects.map((project) => {
            const aspectClass =
              project.data.coverAspectClass || "aspect-[500/675]";
            return (
              <div class="w-full">
                <a
                  href={`/projects/${project.id}`}
                  class="group block text-left"
                >
                  <div class="reveal-block w-full">
                    <div
                      class:list={[
                        "media-wrapper overflow-hidden rounded-3xl bg-neutral-50 mb-6 md:mb-8 transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-98 will-change-transform",
                        aspectClass,
                      ]}
                    >
                      <div class="media-target w-full scale-[1.03] will-change-transform">
                        <Image
                          src={project.data.coverImg}
                          widths={[380, 640, project.data.coverImg.width]}
                          sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 600px"
                          alt={`${project.data.title} Cover Showcase`}
                          class="w-full h-full object-cover select-none pointer-events-none"
                        />
                      </div>
                    </div>
                  </div>
                  <div class="text-lg md:text-xl font-normal tracking-tight leading-snug text-neutral-950 max-w-md">
                    {project.data.tagline}
                  </div>
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
