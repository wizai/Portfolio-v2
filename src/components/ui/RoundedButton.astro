---
interface Props {
  href: string;
  text: string;
  class?: string;
}

const { href, text, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group overflow-hidden inline-flex items-center justify-center select-none cursor-pointer text-white bg-neutral-950 font-medium whitespace-nowrap rounded-full transition-all duration-300 relative",
    "h-14 px-7 text-base font-medium",
    "hover:scale-x-102 hover:duration-600 hover:ease-[cubic-bezier(0.34,5.56,0.64,1)] hover:text-black",
    className,
  ]}
>
  <span
    class="absolute inset-[1px] z-1 overflow-hidden pointer-events-none rounded-[inherit]"
  >
    <span
      class="block w-full h-full bg-white rounded-t-[50%] [translate:0_101%]
             [transition:translate_.6s_cubic-bezier(.4,0,0,1),border-radius_.6s_cubic-bezier(.4,0,0,1)]
             group-hover:[translate:0_0] group-hover:rounded-t-none
             [group-hover:transition-duration:.6s,.9s]"
    >
    </span>
  </span>
  <span class="relative z-2 block overflow-hidden">
    <span
      data-text={text}
      class="block transition-transform duration-800 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-[110%]
             after:content-[attr(data-text)] after:block after:absolute after:top-[110%] after:left-0 after:text-black"
    >
      {text}
    </span>
  </span>
</a>
